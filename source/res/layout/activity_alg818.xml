<?xml version="1.0" encoding="utf-8"?>
<!-- opt24：818 公式熟练度页。
     结构照 activity_lx_study.xml：CustomToolbar + 进度条 + 卡片 + 三档评分，
     多一行「角块 / 棱块 / 混合」分类切换。
     卡片正面只露联想词，点一下才展开公式列表（公式是答案，提前看到等于泄题）。
     id 用 @+id/ 新声明，Java 侧 getIdentifier 按名取，不进 public.xml。 -->
<RelativeLayout android:orientation="vertical" android:background="@drawable/background_page_gradient" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <zd.cornermemory.view.CustomToolbar android:id="@id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:toolbarTitle="@string/alg818_title" />

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="@dimen/toolbar_height" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md">

        <!-- 分类：角块 / 棱块 / 混合 -->
        <LinearLayout android:orientation="horizontal" android:id="@+id/alg818_tabs" android:paddingTop="@dimen/fw_space_8" android:paddingBottom="@dimen/fw_space_4" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_tab_corner" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_36" android:layout_weight="1.0" android:text="@string/alg818_cat_corner" />
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_tab_edge" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_36" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_cat_edge" />
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_tab_mixed" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_36" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_cat_mixed" />
        </LinearLayout>

        <!-- 公式源：内置 818 / 浅梦 202602 / 自定义（三套 case 身份不同，进度各自独立） -->
        <!-- 公式源：内置 818 / 浅梦 202602 / 自定义（三套 case 身份不同，进度各自独立）；窄屏可横向滚动 -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="false">
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/alg818_src_row" android:paddingTop="@dimen/fw_space_4" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:textSize="@dimen/fw_text_10" android:textColor="?attr/app_text_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/alg818_src_label" />
                <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_src_builtin" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_src_builtin" />
                <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_src_qm" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_src_qm" />
                <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_src_custom" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_src_custom" />
                <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_lit_text_059669" android:gravity="center" android:id="@+id/alg818_src_import" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_src_import" />
                <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_src_sets" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/alg818_src_sets" />
                <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/alg818_readme" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:layout_marginStart="@dimen/fw_space_8" android:visibility="gone" android:text="@string/alg818_readme" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 记忆顺序开关 + 分组筛选（分组多时横向滚动） -->
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="@dimen/fw_space_4" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_order" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:paddingStart="@dimen/fw_space_12" android:paddingEnd="@dimen/fw_space_12" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_28" android:text="@string/alg818_order_code" />
            <HorizontalScrollView android:id="@+id/alg818_group_row" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:scrollbars="none" android:fillViewport="false">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/alg818_group_list" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 进度行：本次 x / y  +  待复习 · 新卡 -->
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="@dimen/fw_space_4" android:paddingBottom="@dimen/fw_space_8" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:id="@+id/alg818_progress" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:fontFeatureSettings="tnum" />
            <TextView android:textSize="@dimen/fw_text_11" android:textColor="?attr/app_text_secondary" android:id="@+id/alg818_counts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <ProgressBar android:id="@+id/alg818_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="@dimen/fw_size_4" android:progressDrawable="@drawable/lx_study_progress_bg" android:max="100" android:progress="0" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0">

            <!-- 卡片：正面联想词 + 类型，背面公式列表（可滚动，公式多时展开） -->
            <ScrollView android:id="@+id/alg818_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="@dimen/spacing_md" android:background="@drawable/card_background" android:elevation="@dimen/elevation_sm" android:fillViewport="true" android:scrollbars="none">
                <LinearLayout android:orientation="vertical" android:gravity="center_vertical" android:id="@+id/alg818_card" android:focusable="true" android:clickable="true" android:padding="@dimen/spacing_lg" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:textSize="@dimen/fw_text_11" android:textStyle="bold" android:textColor="?attr/app_lit_text_4f46e5" android:gravity="center" android:id="@+id/alg818_badge" android:background="@drawable/control_chip_bg" android:paddingStart="@dimen/fw_space_8" android:paddingEnd="@dimen/fw_space_8" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_20" android:layout_gravity="center_horizontal" />
                    <TextView android:textSize="@dimen/fw_text_40" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_word" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fw_space_8" android:lineSpacingExtra="@dimen/fw_space_2" />
                    <TextView android:textSize="@dimen/fw_text_12" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/alg818_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fw_space_8" android:layout_gravity="center_horizontal" android:text="@string/alg818_tap_hint" />

                    <!-- 背面：case 说明 + 公式列表 + 展开 + 熟练度 -->
                    <LinearLayout android:orientation="vertical" android:id="@+id/alg818_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone">
                        <TextView android:textSize="@dimen/fw_text_12" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/alg818_case" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:fontFeatureSettings="tnum" />
                        <TextView android:textSize="@dimen/fw_text_11" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/alg818_alg_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fw_space_4" />
                        <LinearLayout android:orientation="vertical" android:id="@+id/alg818_alg_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fw_space_8" />
                        <TextView android:textSize="@dimen/fw_text_12" android:textStyle="bold" android:textColor="?attr/app_lit_text_4f46e5" android:gravity="center" android:id="@+id/alg818_expand" android:focusable="true" android:clickable="true" android:paddingTop="@dimen/fw_space_8" android:paddingBottom="@dimen/fw_space_8" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                        <TextView android:textSize="@dimen/fw_text_10" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/alg818_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/fw_space_4" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- 空态：这一分类练完了 -->
            <LinearLayout android:orientation="vertical" android:gravity="center" android:id="@+id/alg818_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
                <TextView android:textSize="@dimen/fw_text_40" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎯" android:contentDescription="@null" />
                <TextView android:textSize="@dimen/fw_text_18" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" />
                <TextView android:textSize="@dimen/fw_text_13" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/alg818_empty_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:lineSpacingExtra="@dimen/fw_space_2" />
                <TextView android:textSize="@dimen/fw_text_14" android:textStyle="bold" android:textColor="@android:color/white" android:gravity="center" android:id="@+id/alg818_new_btn" android:background="@drawable/timer_input_confirm_bg" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_48" android:paddingStart="@dimen/spacing_lg" android:paddingEnd="@dimen/spacing_lg" android:layout_marginTop="@dimen/spacing_md" />
            </LinearLayout>
        </FrameLayout>

        <!-- 三档评分：忘记 / 模糊 / 记得（未翻面时变淡，点了只提示先翻面） -->
        <LinearLayout android:orientation="horizontal" android:id="@+id/alg818_actions" android:paddingTop="@dimen/spacing_sm" android:paddingBottom="@dimen/spacing_sm" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/fw_text_14" android:textStyle="bold" android:textColor="?attr/app_lit_text_dc2626" android:gravity="center" android:id="@+id/alg818_again" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_48" android:layout_weight="1.0" android:text="@string/lx_study_again" />
            <TextView android:textSize="@dimen/fw_text_14" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/alg818_hard" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_48" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/lx_study_hard" />
            <TextView android:textSize="@dimen/fw_text_14" android:textStyle="bold" android:textColor="@android:color/white" android:gravity="center" android:id="@+id/alg818_good" android:background="@drawable/timer_input_confirm_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_48" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/lx_study_good" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
