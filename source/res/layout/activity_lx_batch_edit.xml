<?xml version="1.0" encoding="utf-8"?>
<!-- opt21：批量编辑联想词页。
     结构照 activity_lx_batch_import.xml（CustomToolbar + 卡片），尺寸全走 @dimen/fw_*。
     id 用 @+id/ 新声明，Java 侧 getIdentifier 按名取，不进 public.xml。
     ListView 让行内 EditText 可聚焦（Java 侧 setItemsCanFocus(true)）。 -->
<RelativeLayout android:orientation="vertical" android:background="@drawable/background_page_gradient" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <zd.cornermemory.view.CustomToolbar android:id="@id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:toolbarTitle="@string/lx_batch_edit_title" />

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="@dimen/toolbar_height">

        <!-- 搜索 + 批量替换 -->
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md" android:paddingTop="@dimen/spacing_sm" android:paddingBottom="@dimen/spacing_sm" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:textSize="@dimen/fw_text_14" android:textColor="?attr/app_text_primary" android:textColorHint="?attr/app_text_hint" android:id="@+id/lx_edit_search" android:background="@drawable/search_input_bg" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_46" android:hint="@string/lx_batch_edit_search_hint" android:maxLines="1" android:inputType="text" android:imeOptions="actionSearch" android:paddingStart="@dimen/fw_space_14" android:paddingEnd="@dimen/fw_space_14" android:layout_weight="1.0" />
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_colorPrimary" android:gravity="center" android:id="@+id/lx_edit_replace" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="wrap_content" android:layout_height="@dimen/fw_size_46" android:paddingStart="@dimen/fw_space_14" android:paddingEnd="@dimen/fw_space_14" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/lx_batch_edit_replace_action" />
        </LinearLayout>

        <ListView android:id="@+id/lx_edit_list" android:background="@drawable/card_background" android:divider="@null" android:dividerHeight="0.0dip" android:paddingStart="@dimen/spacing_sm" android:paddingEnd="@dimen/spacing_sm" android:paddingTop="@dimen/fw_size_4" android:paddingBottom="@dimen/fw_size_4" android:clipToPadding="false" android:descendantFocusability="beforeDescendants" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" android:elevation="@dimen/elevation_sm" android:scrollbars="none" />

        <!-- 底部操作栏：恢复全部默认（次） + 保存修改（主） -->
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md" android:paddingTop="@dimen/spacing_sm" android:paddingBottom="@dimen/spacing_sm" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/fw_text_14" android:textStyle="bold" android:textColor="?attr/app_text_secondary" android:gravity="center" android:id="@+id/lx_edit_reset_all" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_48" android:layout_weight="1.0" android:text="@string/lx_batch_edit_reset_all" />
            <TextView android:textSize="@dimen/fw_text_14" android:textStyle="bold" android:textColor="@android:color/white" android:gravity="center" android:id="@+id/lx_edit_save" android:background="@drawable/timer_input_confirm_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_48" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_12" android:text="@string/lx_batch_edit_save" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
