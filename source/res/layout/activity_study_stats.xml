<?xml version="1.0" encoding="utf-8"?>
<!-- opt25：学习统计页。
     CustomToolbar + 源切换（总体 / 联想词 / 818）+ 可滚动内容区。
     内容卡片全部由 Java 按数据动态拼（StudyStatsActivity），这里只留容器，
     免得为每种卡片写一份 layout。id 用 @+id/ 新声明，Java 侧 getIdentifier 按名取。 -->
<RelativeLayout android:orientation="vertical" android:background="@drawable/background_page_gradient" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <zd.cornermemory.view.CustomToolbar android:id="@id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:toolbarTitle="@string/study_stats_title" />

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="@dimen/toolbar_height" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md">

        <LinearLayout android:orientation="horizontal" android:id="@+id/study_stats_tabs" android:paddingTop="@dimen/fw_space_8" android:paddingBottom="@dimen/fw_space_4" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/study_stats_tab_all" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_36" android:layout_weight="1.0" android:text="@string/study_stats_tab_all" />
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/study_stats_tab_lx" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_36" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/study_stats_tab_lx" />
            <TextView android:textSize="@dimen/fw_text_13" android:textStyle="bold" android:textColor="?attr/app_text_primary" android:gravity="center" android:id="@+id/study_stats_tab_alg" android:background="@drawable/control_chip_bg" android:focusable="true" android:clickable="true" android:layout_width="0.0dp" android:layout_height="@dimen/fw_size_36" android:layout_weight="1.0" android:layout_marginStart="@dimen/fw_space_8" android:text="@string/study_stats_tab_alg" />
        </LinearLayout>

        <ScrollView android:id="@+id/study_stats_scroll" android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_weight="1.0" android:layout_marginTop="@dimen/spacing_sm" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:orientation="vertical" android:id="@+id/study_stats_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="@dimen/spacing_lg" />
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
